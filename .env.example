# Run python3 scripts/configure.py to create .env with random local secrets.
# Configure HTTPS and secure cookies before exposing the installation remotely.
PUBLIC_HOST=127.0.0.1
UI_PORT=8088
API_PORT=8080
API_HOST=0.0.0.0
UI_HOST=127.0.0.1
BACKEND_URL=http://127.0.0.1:8080
BACKEND_DNS_IPV6=off
BACKEND_DNS_VALID_SECONDS=10
DISPATCHER_PUBLIC_URL=http://127.0.0.1:8088
DISPATCHER_SECURE_COOKIES=false
DISPATCHER_SESSION_SECRET=
POSTGRES_DB=dispatcher
POSTGRES_USER=dispatcher_owner
POSTGRES_PASSWORD=
DISPATCHER_APP_DB_PASSWORD=
DISPATCHER_AUTH_DB_PASSWORD=
DISPATCHER_DATABASE_URL=
DISPATCHER_AUTH_DATABASE_URL=
DISPATCHER_MIGRATION_DATABASE_URL=
DISPATCHER_RECOVERY_DATABASE_URL=
BACKUP_DIRECTORY=./backups
RECOVERY_UID=0
RECOVERY_GID=0
DISPATCHER_WORKER_INTERVAL=30
DISPATCHER_HEARTBEAT_GRACE_SECONDS=300
DISPATCHER_EXPORT_ROWS=10000
DISPATCHER_RETENTION_BATCH_ROWS=1000
DISPATCHER_CONFIG_SOURCES={}
INSTALL_GIT=false
DISPATCHER_CONFIG_POLL_SECONDS=60
DISPATCHER_CONFIG_RUNTIME_TTL=300
DISPATCHER_CONFIG_CLOCK_SKEW_SECONDS=30
# Optional until real sign-in is enabled. Set these in the API service's Railway
# Variables or local .env; leave secrets blank in tracked configuration.
DISPATCHER_SMTP_HOST=
DISPATCHER_SMTP_PORT=587
DISPATCHER_SMTP_SENDER=
DISPATCHER_SMTP_USER=
DISPATCHER_SMTP_PASSWORD=
DISPATCHER_SMTP_STARTTLS=true
DISPATCHER_GOOGLE_CLIENT_ID=
DISPATCHER_GOOGLE_CLIENT_SECRET=
# Optional temporary password sign-in for one existing email identity. No default password.
# Generate the hash with scripts/password_hash.py; set all three values together.
DISPATCHER_TEST_LOGIN_EMAIL=
DISPATCHER_TEST_LOGIN_PASSWORD_HASH=
DISPATCHER_TEST_LOGIN_EXPIRES_AT=
DISPATCHER_AGENTDESK_IDENTITY_URL=
DISPATCHER_TOOL_RESOURCE_URL=
DISPATCHER_TOOL_TOKEN_SECONDS=3600
MCP_HOST=0.0.0.0
MCP_PORT=8090
POSTGRES_IMAGE=postgres:17.11-alpine
PGVECTOR_VERSION=0.8.7
PGVECTOR_SOURCE_URL=https://codeload.github.com/pgvector/pgvector/tar.gz/refs/tags/v0.8.7
PGVECTOR_SHA256=cac0b10c360f05b2d521200105ba3697e773d4cd3731f5a915a7e37ebe0bea85
PYTHON_IMAGE=python:3.12.16-alpine3.24
NODE_IMAGE=node:24.22.2-alpine
NGINX_IMAGE=nginx:1.30.6-alpine
# Integration profiles are opt-in; provider credentials are configured separately.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.106.6
LITELLM_MASTER_KEY=
LITELLM_DATABASE_URL=
DISPATCHER_GATEWAY_DB_PASSWORD=
DISPATCHER_GATEWAY_CALLBACK_SECRET=
DISPATCHER_GATEWAY_URL=http://gateway:4000
# Optional direct/private client address. Empty uses DISPATCHER_PUBLIC_URL/llm/v1.
DISPATCHER_GATEWAY_CLIENT_URL=
# Vite development proxy; Compose supplies its own private service address.
GATEWAY_URL=http://127.0.0.1:4000
GATEWAY_READ_TIMEOUT_SECONDS=600
DISPATCHER_CALLBACK_URL=http://api:8080
LITELLM_PORT=4000
LLM_PROVIDER_MODEL=
LLM_API_KEY=
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.164.0
GO_IMAGE=golang:1.27.3-alpine3.24
COLLECTOR_BUILDER_VERSION=v0.164.0
GO_LICENSES_VERSION=v2.0.1
OTEL_HTTP_HOST=0.0.0.0
OTEL_HTTP_PORT=4318
OTEL_HEALTH_ENDPOINT=0.0.0.0:13133
DISPATCHER_COLLECTOR_TOKEN=
DISPATCHER_OTLP_SDK_KEY=
DISPATCHER_TELEMETRY_MAX_BYTES=1048576
DISPATCHER_SOURCE_STALE_SECONDS=300
DISPATCHER_REQUEST_LIMIT=1000
OTEL_BATCH_SIZE=100
OTEL_BATCH_TIMEOUT=1s

# Latest CLI account measurements older than this are shown as stale (API service).
DISPATCHER_ACCOUNT_STALE_SECONDS=900

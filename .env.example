# Run python3 scripts/configure.py to create .env with random local secrets.
# Configure HTTPS and secure cookies before exposing the installation remotely.
PUBLIC_HOST=127.0.0.1
UI_PORT=8088
API_PORT=8080
API_HOST=0.0.0.0
UI_HOST=127.0.0.1
BACKEND_URL=http://127.0.0.1:8080
DISPATCHER_PUBLIC_URL=http://127.0.0.1:8088
DISPATCHER_SECURE_COOKIES=false
DISPATCHER_SESSION_SECRET=
POSTGRES_DB=dispatcher
POSTGRES_USER=dispatcher_owner
POSTGRES_PASSWORD=
DISPATCHER_APP_DB_PASSWORD=
DISPATCHER_AUTH_DB_PASSWORD=
DISPATCHER_DATABASE_URL=
DISPATCHER_AUTH_DATABASE_URL=
DISPATCHER_MIGRATION_DATABASE_URL=
DISPATCHER_RECOVERY_DATABASE_URL=
BACKUP_DIRECTORY=./backups
RECOVERY_UID=0
RECOVERY_GID=0
DISPATCHER_WORKER_INTERVAL=30
DISPATCHER_HEARTBEAT_GRACE_SECONDS=300
DISPATCHER_EXPORT_ROWS=10000
DISPATCHER_RETENTION_BATCH_ROWS=1000
DISPATCHER_CONFIG_SOURCES={}
INSTALL_GIT=false
DISPATCHER_CONFIG_POLL_SECONDS=60
DISPATCHER_CONFIG_RUNTIME_TTL=300
DISPATCHER_CONFIG_CLOCK_SKEW_SECONDS=30
DISPATCHER_SMTP_HOST=
DISPATCHER_SMTP_PORT=587
DISPATCHER_SMTP_SENDER=
DISPATCHER_SMTP_USER=
DISPATCHER_SMTP_PASSWORD=
DISPATCHER_SMTP_STARTTLS=true
DISPATCHER_GOOGLE_CLIENT_ID=
DISPATCHER_GOOGLE_CLIENT_SECRET=
DISPATCHER_AGENTDESK_IDENTITY_URL=
DISPATCHER_TOOL_RESOURCE_URL=
DISPATCHER_TOOL_TOKEN_SECONDS=3600
MCP_HOST=0.0.0.0
MCP_PORT=8090
POSTGRES_IMAGE=postgres:17.11-alpine
PYTHON_IMAGE=python:3.12.16-alpine3.24
NODE_IMAGE=node:24.22.2-alpine
NGINX_IMAGE=nginx:1.30.6-alpine
# Integration profiles are opt-in until provider billing correlation is implemented.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.106.6
LITELLM_MASTER_KEY=
LITELLM_DATABASE_URL=
DISPATCHER_GATEWAY_DB_PASSWORD=
DISPATCHER_GATEWAY_CALLBACK_SECRET=
DISPATCHER_GATEWAY_URL=http://gateway:4000
DISPATCHER_CALLBACK_URL=http://api:8080
LITELLM_PORT=4000
LLM_PROVIDER_MODEL=
LLM_API_KEY=

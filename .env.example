# Run python3 scripts/configure.py to create .env with random local secrets.
# Configure HTTPS and secure cookies before exposing the installation remotely.
PUBLIC_HOST=127.0.0.1
UI_PORT=8088
API_PORT=8080
API_HOST=0.0.0.0
UI_HOST=127.0.0.1
BACKEND_URL=http://127.0.0.1:8080
DISPATCHER_PUBLIC_URL=http://127.0.0.1:8088
DISPATCHER_SECURE_COOKIES=false
DISPATCHER_SESSION_SECRET=
POSTGRES_DB=dispatcher
POSTGRES_USER=dispatcher_owner
POSTGRES_PASSWORD=
DISPATCHER_APP_DB_PASSWORD=
DISPATCHER_AUTH_DB_PASSWORD=
DISPATCHER_DATABASE_URL=
DISPATCHER_AUTH_DATABASE_URL=
DISPATCHER_MIGRATION_DATABASE_URL=
DISPATCHER_WORKER_INTERVAL=30
DISPATCHER_HEARTBEAT_GRACE_SECONDS=300
DISPATCHER_SMTP_HOST=
DISPATCHER_SMTP_PORT=587
DISPATCHER_SMTP_SENDER=
DISPATCHER_SMTP_USER=
DISPATCHER_SMTP_PASSWORD=
DISPATCHER_SMTP_STARTTLS=true
DISPATCHER_GOOGLE_CLIENT_ID=
DISPATCHER_GOOGLE_CLIENT_SECRET=
POSTGRES_IMAGE=postgres:17.6-alpine
PYTHON_IMAGE=python:3.12.12-slim
NODE_IMAGE=node:24.13.1-alpine
NGINX_IMAGE=nginx:1.28.0-alpine
# Integration profiles are opt-in until provider billing correlation is implemented.
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-v1.106.6-stable
LITELLM_MASTER_KEY=
LITELLM_PORT=4000
LLM_PROVIDER_MODEL=
LLM_API_KEY=
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.164.0
OTEL_HTTP_ENDPOINT=0.0.0.0:4318
OTEL_HEALTH_ENDPOINT=0.0.0.0:13133

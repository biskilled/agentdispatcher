OTEL_HTTP_HOST=0.0.0.0
OTEL_HTTP_PORT=4318
OTEL_HEALTH_ENDPOINT=0.0.0.0:13133
DISPATCHER_COLLECTOR_TOKEN=
DISPATCHER_OTLP_SDK_KEY=
